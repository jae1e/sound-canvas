{
  "expo": {
    "name": "Voice Coach",
    "slug": "voice-life-companion",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jae1e.voicelifecompanion"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jae1e.voicelifecompanion",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "vlc",
    "plugins": [
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "minSdkVersion": 31,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Voice Life Companion uses your location for walking guidance and to save where you wrote a note.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-localization"
    ]
  }
}
